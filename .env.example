# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca se commitea.

# --- Sesión -------------------------------------------------------------
# 32 caracteres o más. En producción la app TIRA si falta o es corto: sin un
# secreto propio, cualquiera que lea el repositorio puede firmar una sesión.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Acceso -------------------------------------------------------------
# "0" apaga el gate de Cidituc en desarrollo. Cualquier otro valor lo deja activo.
#
# Ojo: apagarlo deja leer el diario SIN sesion, o sea tambien sin usuario. No es
# una forma de entrar al panel; es una forma de leer sin ingresar.
AUTH_CIDITUC=

# --- Ingreso con Cidituc ------------------------------------------------
# "1" prende el ingreso. Sin esto (o si falta cualquiera de las tres URLs de
# abajo) el boton de /login se reemplaza por un aviso y NADIE puede conseguir
# una sesion: el unico emisor es el callback, y el callback exige un token que
# valida el backend municipal.
CIDITUC_HABILITADO=

# La pantalla de ingreso del municipio. Va el ORIGEN SOLO: el "#/login" lo
# agrega urlDelDerivador() en src/lib/auth/cidituc/derivador.ts.
# Produccion: https://cidituc.smt.gob.ar
# Local: el repo `derivador` corriendo, normalmente http://localhost:5174
#   (el derivador desplegado devuelve null para localhost, asi que contra
#   produccion el flujo completo NO se puede reproducir).
CIDITUC_DERIVADOR_URL=

# El backend contra el que se valida el token.
# Produccion: https://estadisticas.smt.gob.ar:5000
CIDITUC_API_URL=

# La URL de retorno. Tiene que ser EXACTAMENTE la registrada en el derivador
# (repo `derivador`, src/components/Login/Login.jsx, mapa RESPALDO_CALLBACK).
# Si no coinciden, el sintoma engana: el primer intento falla con "la solicitud
# vencio" y el segundo entra bien, en el dominio equivocado.
# Produccion: https://el-sanmiguelino.vercel.app/auth/cidituc/callback
# Local: http://localhost:3000/auth/cidituc/callback
CIDITUC_CALLBACK_URL=

# Con que clave nos identifica el derivador: /#/login?next=<clave>. Por defecto
# "sanmiguelino". Cambiarla acá sin cambiarla allá rompe el ingreso.
CIDITUC_CLAVE_APP=

# OPCIONAL. Certificado PEM que reemplaza al intermedio de Sectigo embebido en
# src/lib/auth/cidituc/sectigo-ca.ts. Sirve para rotarlo sin redesplegar. Vacia
# usa el embebido, que es lo normal.
CIDITUC_CA_PEM=

# --- Panel de administración --------------------------------------------
# Los id_persona de Cidituc que administran el diario, separados por coma.
#
# YA NO es la fuente provisoria: desde que existe /admin/usuarios, el rol normal
# sale de la tabla. Esta lista quedo como la RED ANTI-LOCKOUT, y gana ANTES de
# tocar la base y tambien sobre el bloqueo. Los dos detalles son el punto: una
# red que necesita que Supabase responda no es una red, y si el entorno ganara
# solo sobre el rol, a alguien de esta lista lo podrian bloquear desde la
# pantalla y no tendria como entrar a desbloquearse.
#
# Con la base caida, o despues de un clic equivocado, tiene que seguir habiendo
# alguien que pueda entrar a arreglarlo. Ese es el unico proposito.
#
# Vacia por default: sin nombres cargados el unico camino al panel es la tabla,
# que tambien arranca vacia. Va en el entorno y no en el codigo para que agregar
# o sacar a alguien no necesite un commit.
#
# Para arrancar en una instalacion nueva -o en local- pone tu propio id_persona
# aca: es el unico bootstrap posible, porque la tabla se llena sola con los
# ingresos y nadie puede darse permisos a si mismo. Tu id lo dice
# GET /api/auth/quien-soy, que existe solo fuera de produccion.
#
# Ojo: a quien este aca, /admin/usuarios NO le ofrece cambiarle el rol. No es
# prolijidad, es que la escritura no tendria ningun efecto.
CIDITUC_ADMINS=

# Interruptor de existencia de /admin. Sin esto esas rutas responden 404 (no un
# redirect: lo que no esta listo no se anuncia).
#
# Son tres llaves en AND, todas cerradas por default: la sesion tiene que venir
# de un token que valido el backend de Cidituc, el permiso resuelto tiene que
# ser admin y sin bloqueo -de CIDITUC_ADMINS o de la tabla usuarios, en ese
# orden-, y ademas esto tiene que estar en "1". Desplegar el repo tal cual, sin
# tocar variables y con la tabla vacia: /admin es 404 para todos. Ver requerirAdmin() en
# src/lib/auth/dal.ts.
ADMIN_HABILITADO=


# --- Base de datos (Supabase) -------------------------------------------
# Supabase -> boton "Connect" (arriba) -> pestana ORMs -> Prisma.
# Ahi salen las dos cadenas ya armadas. Si preferis copiarlas a mano, la unica
# diferencia entre las dos es el puerto y lo que va despues del "?".
#
# Runtime: "Transaction pooler", puerto 6543. El ?pgbouncer=true lo pone
# Supabase y conviene dejarlo; el connection_limit, en cambio, no lo lee nadie
# bajo el modelo de adapters de Prisma 7: el tope del pool es el max de db.ts.
# postgresql://postgres.<ref>:<PASS>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
#
# Migraciones: "Session pooler", MISMO host, puerto 5432, SIN sufijo.
# postgresql://postgres.<ref>:<PASS>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# No uses la "Direct connection" (db.<ref>.supabase.co): Supabase la dejo solo
# por IPv6, y si tu red no tiene IPv6 el migrate falla con un timeout que no
# explica nada.
#
# Si la contrasena tiene @ : / ? # o &, hay que escaparla (@ es %40, # es %23).
# Sin escapar, esos caracteres cortan la URL y el error habla de un host raro.
DIRECT_URL=

# --- Storage de imágenes (Supabase) -------------------------------------
# La direccion publica de la API del proyecto. NO es un secreto: es
# https://<ref>.supabase.co, y el ref ya esta adentro de DATABASE_URL.
SUPABASE_URL=

# El bucket donde van las fotos de las notas. Tiene que existir y ser PUBLICO
# de lectura: las fotos de un diario se ven sin iniciar sesion en ningun lado,
# y ademas el optimizador de imagenes de Next las busca sin credenciales.
# La escritura la hace solo el servidor, con la clave de abajo.
SUPABASE_BUCKET=diario

# Project Settings -> API -> service_role.
#
# NUNCA con prefijo NEXT_PUBLIC_: esta clave saltea toda politica de acceso, o
# sea que quien la tenga puede leer y escribir TODA la base, no solo el
# storage. Va solo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Migue (OpenRouter) -------------------------------------------------
# La clave de OpenRouter. Sin esto Migue sigue andando, pero con el buscador
# por palabras clave de siempre en vez del modelo.
#
# Se saca en https://openrouter.ai/keys. NUNCA con prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# El modelo. Por defecto openai/gpt-4o-mini. Cambiarlo aca no toca codigo.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcional: a donde se le pregunta. Sirve para poner un proxy propio del
# municipio delante, o un gateway compatible con la API de OpenAI. Vacia usa
# OpenRouter.
OPENROUTER_URL=

# Solo para que OpenRouter atribuya el trafico en su panel. No es una
# credencial y se puede dejar vacia.
SITIO_URL=https://el-sanmiguelino.vercel.app

# Topes de consultas AL MODELO por hora. Pasarse no rompe a Migue: sigue
# contestando con el buscador por palabras clave, que no cuesta nada.
#
# El global es el techo de gasto de verdad: si mil vecinos preguntan veinte
# veces cada uno, el tope individual no protege nada.
MIGUE_TOPE_PERSONA=20
MIGUE_TOPE_GLOBAL=300

# --- La voz de Migue (ElevenLabs) ---------------------------------------
# La clave de ElevenLabs. Sin esto la lectura en voz alta sigue andando: Migue
# lee con la voz del navegador (speechSynthesis), que es gratis y no necesita
# red. Cambia la voz, no la funcion.
#
# Se saca en https://elevenlabs.io -> foto de perfil (abajo a la izquierda) ->
# "API Keys". NUNCA con prefijo NEXT_PUBLIC_: cada caracter que se sintetiza se
# cobra, asi que quien tenga la clave puede gastar el presupuesto del municipio.
# Va solo en el servidor.
#
# No alcanza por si sola: tambien tiene que estar cargado VOZ_DE_MIGUE_ID en
# src/lib/voz/elevenlabs.ts. Ese id NO es un secreto y por eso va en el codigo.
# Mientras falte cualquiera de los dos, no se llama a ElevenLabs ni se gasta.
ELEVENLABS_API_KEY=

# Conexiones simultaneas del pool, por instancia. Tres es conservador: contra el
# pooler de Supabase en modo transaccion las conexiones de cliente son baratas,
# pero el numero se multiplica por cada instancia que Vercel levante.
DB_POOL_MAX=3

# Cuanto espera el pool antes de cerrar una conexion ociosa, en ms. Cero = no
# la cierra. El default de pg-pool son 10 segundos, y para un diario ese es el
# peor numero posible: el lector lee la nota un minuto, pasa de pagina y paga
# de nuevo el TCP, el TLS y la autenticacion del pooler. Medido: 54ms en
# caliente contra 271ms tras 12 segundos quieto.
DB_POOL_IDLE_MS=0
