// Esquema de la edición y de los comentarios.
//
// Traduce las formas de `src/lib/types.ts` a Postgres, sin cambiarlas. La
// prueba de que la traducción es fiel es que `npm run verificar:comentarios`
// tiene que seguir pasando contra este motor sin tocarle una línea.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 sacó las URLs del esquema. La de migraciones vive en
  // `prisma.config.ts` (conexión directa, 5432: el pooler en modo transacción
  // no soporta el DDL de `prisma migrate`), y la de runtime se le pasa al
  // adapter en `src/lib/db.ts` (el pooler, 6543).
}

model Edicion {
  id       String  @id @default(cuid())
  slug     String  @unique
  /// ej.: "Agosto de 2026"
  mes      String
  numero   Int
  anio     Int
  /// "Edición mensual" y cosas así: el rótulo del número, no su contenido.
  etiqueta String?

  /// De qué se trata este número: "Historia de San Miguel de Tucumán".
  ///
  /// El Sanmiguelino no se divide en secciones fijas —Cultura, Ciudad, Obras—:
  /// **cada edición es un tema y todas sus notas hablan de eso**. La barra del
  /// diario mostraba las secciones de las notas, que con este modelo es una
  /// lista de una sola cosa repetida.
  ///
  /// Opcional porque las ediciones viejas no lo tienen: agosto ya salió con
  /// secciones cargadas y tiene que seguir viéndose como salió. Si hay tema, la
  /// barra lo muestra; si no, muestra las secciones de siempre.
  tema String?

  /// Cuándo sale esta edición. `null` = todavía no tiene fecha, así que no
  /// se publica nunca sola.
  ///
  /// **La edición que se sirve se calcula con esto, no se marca.** Es la más
  /// reciente cuya fecha ya pasó. Antes había un booleano `actual` que alguien
  /// tenía que dar vuelta el día 1, y esa es la diferencia que importa: una
  /// bandera necesita que algo corra a las 00:00 —un cron, una persona— y si
  /// ese algo falla el diario se queda en el mes pasado sin que nadie se
  /// entere. Una fecha no necesita que corra nada: si el sitio está en pie,
  /// sirve la edición correcta. Volver atrás es cambiar la fecha.
  ///
  /// Se guarda en UTC, como todo `DateTime` de Prisma. Quien la carga la
  /// escribe en hora de Tucumán y la conversión es del panel: "el 1 de
  /// septiembre" son las 03:00 UTC, no las 00:00, y con tres horas de por medio
  /// una edición mal cargada sale el 31 de agosto a la noche.
  publicaEn DateTime?

  /// El PDF del impreso, cuando el número se publica como facsímil.
  ///
  /// URL pública del objeto en Storage. `null` = esta edición se arma con notas
  /// escritas, como agosto y septiembre. **Las dos formas conviven**: el diario
  /// mira esta columna para decidir qué sirve, así que una edición vieja se
  /// sigue viendo exactamente como salió. Una edición con PDF, en cambio, no
  /// tiene notas escritas: sus `notas` son las páginas del PDF (ver
  /// `Nota.pdfPagina`).
  ///
  /// El archivo **no pasa por el servidor**: el navegador lo sube directo a
  /// Storage con una URL firmada de un solo uso. En Vercel el cuerpo de un
  /// request tiene un tope duro de 4,5 MB y un diario mensual se lo pasa
  /// siempre, así que subirlo por una Server Action fallaría en producción y
  /// andaría en la máquina de quien lo programó.
  pdfUrl String?

  /// Cuántas páginas tiene ese PDF: el foliado del número.
  ///
  /// Se guarda y no se cuenta al leer. Contarlas exige bajar y parsear el PDF
  /// entero —decenas de megas— y esto se necesita en CADA request para dibujar
  /// el mando de paso de página.
  pdfPaginas Int?

  notas Nota[]

  @@unique([anio, numero])
  /// La consulta de cada request: la más reciente con fecha ya pasada.
  @@index([publicaEn])
  @@map("ediciones")
}

model Nota {
  id      String @id @default(cuid())
  slug    String @unique
  /// Hoy es texto libre, igual que en el mock: las secciones se derivan
  /// agrupando las notas. Convertirlo en tabla cambiaría el orden y los slugs
  /// de /seccion/*, así que es una migración aparte y no ésta.
  seccion String
  titulo  String
  bajada  String

  /// BloqueNota[] serializado. Es Json y no una tabla de bloques a propósito:
  /// el cuerpo se lee y se escribe siempre entero, nunca se consulta por
  /// bloque, y el historial de versiones está fuera de alcance.
  ///
  /// Ojo al comparar contra el mock: Postgres guarda esto como JSONB, que
  /// **reordena las claves** de cada objeto (por longitud y después
  /// alfabéticamente). Un bloque de cita sale como `tipo, autor, cargo,
  /// texto` aunque se haya escrito `tipo, texto, autor, cargo`. El orden del
  /// array y los valores no se tocan, así que a la aplicación le da igual;
  /// pero un `JSON.stringify` de los dos lados reporta diferencias que no
  /// existen.
  cuerpo Json

  /// Derivados del cuerpo, calculados AL ESCRIBIR. Por eso existen como
  /// columnas: son lo que permite que un listado no traiga ocho cuerpos para
  /// mostrar títulos.
  minutosLectura Int
  /// Exactamente `cuerpo.map(textoDeBloque).join(" ")` (ver src/lib/derivar).
  /// No es `b.texto`: una ficha no tiene ese campo. El resaltado de
  /// resultados corta el fragmento con índices sobre esta misma cadena, así
  /// que no puede normalizarse ni recortarse: tiene que seguir siendo eso.
  /// Quien escriba el cuerpo escribe esto en la misma transacción.
  textoPlano     String

  /// Campos de ImagenNota, aplanados. Son tres columnas y no una tabla porque
  /// es una imagen por nota; la galería no está en el alcance.
  imagenSrc      String?
  imagenAlt      String?
  imagenEpigrafe String?

  /// El foliado ("Página 5 de 9") sale de acá. El orden de un array no
  /// sobrevive a una base: sin esta columna, el número de página cambiaría
  /// solo entre requests.
  orden Int

  /// Qué página del PDF es, cuando la edición se publica como facsímil.
  ///
  /// **En una edición con PDF, una página del impreso ES una fila de `notas`, y
  /// es deliberado.** La alternativa era una tabla propia de páginas, y costaba
  /// rehacer todo lo que ya cuelga de una nota: los comentarios tienen una clave
  /// externa contra `notas.slug` —con su ON UPDATE CASCADE—, el foliado sale de
  /// `orden`, el mando de paso de página se arma con el índice y la moderación
  /// lista por nota. Una página que no es una nota necesitaría un segundo camino
  /// para cada una de esas cosas, y comentarios anclados a dos lugares distintos.
  ///
  /// Estas filas no las escribe nadie a mano: las crea y las borra la carga del
  /// PDF, con título "Página N", sin cuerpo y sin texto plano. Sin cuerpo el
  /// buscador nunca las devuelve, que es lo correcto: de un facsímil no se
  /// extrae texto (y si el PDF es un escaneo, no hay texto que extraer).
  ///
  /// **Empieza en 2.** La página 1 del PDF es la tapa y se sirve en `/diario`,
  /// que es la página 1 de siempre y nunca llevó comentarios. Así el foliado no
  /// cambia: la nota k-ésima de la edición sigue siendo la página k+1, o sea que
  /// acá vale `pdfPagina = orden + 2`. Las dos columnas se escriben juntas en la
  /// misma transacción; ninguna se deriva de la otra al leer.
  pdfPagina Int?

  edicionId String
  edicion   Edicion @relation(fields: [edicionId], references: [id], onDelete: Cascade)

  comentarios Comentario[]

  @@unique([edicionId, orden])
  @@index([edicionId, seccion])
  @@map("notas")
}

model Comentario {
  id String @id @default(cuid())

  /// La relación va por slug y no por id porque toda la API del repo pide por
  /// slug, y así el listado de una nota es una consulta sola. El admin puede
  /// editar el slug de una nota, y para eso está el ON UPDATE CASCADE: si
  /// cambia, los comentarios lo siguen en vez de quedar huérfanos.
  notaSlug String
  nota     Nota   @relation(fields: [notaSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  /// El autor viene de Cidituc. Existe la tabla `Usuario` —para el rol y el
  /// bloqueo— pero acá NO hay clave externa hacia ella: hay `usuarioId` de la
  /// época del login mock que no corresponden a ningún `id_persona`, y borrar a
  /// alguien de esa tabla no puede arrastrar los comentarios de un vecino.
  /// El nombre se guarda desnormalizado a propósito — es el nombre con
  /// el que la persona firmó ese día, y no debería cambiar retroactivamente en
  /// comentarios ya publicados si después se lo cambia en Cidituc.
  usuarioId     String
  usuarioNombre String

  texto String
  fecha DateTime @default(now())

  /// "publicado" | "oculto". Es texto y no enum de Postgres para que agregar
  /// un estado más adelante no sea una migración con lock de tabla.
  estado String @default("publicado")

  /// Rastro de la baja. Un comentario oculto no se borra: una publicación
  /// oficial que esconde la palabra de un vecino tiene que poder decir quién
  /// lo decidió.
  ocultadoPor String?
  ocultadoEn  DateTime?
  motivoBaja  String?

  votos Voto[]

  /// El listado de una nota filtra por estado y ordena por fecha.
  @@index([notaSlug, estado, fecha])
  /// La portada busca el último comentario visible de toda la edición.
  @@index([estado, fecha])
  @@map("comentarios")
}

model Voto {
  comentarioId String
  comentario   Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  /// 1 o -1. Quitar el voto borra la fila; no existe el 0.
  valor        Int

  /// Un voto por persona y por comentario. La restricción vive acá y no en la
  /// aplicación: dos pedidos simultáneos del mismo usuario no pueden dejar dos
  /// filas.
  @@id([comentarioId, usuarioId])
  @@index([comentarioId])
  @@map("votos")
}

/// Una pregunta que alguien le hizo a Migue.
///
/// **No guarda quién preguntó, y es deliberado.** El tablero existe para saber
/// qué no supimos contestar y dónde falta cobertura, y para eso el texto y el
/// resultado alcanzan. Atar cada pregunta a un vecino identificado convertiría
/// un registro de calidad en un historial de consultas de una persona ante el
/// municipio, que es otra cosa y necesitaría otro permiso. Guardar de menos es
/// el default correcto en una publicación oficial.
model ConsultaMigue {
  id       String @id @default(cuid())
  pregunta String

  /// Cómo terminó: "saludo", "indice", "nota" o "sin_respuesta". Es texto y no
  /// enum de Postgres para que sumar un caso no sea una migración con lock.
  resultado String

  /// La nota con la que respondió, si respondió con una. Sin relación a
  /// `notas`: la consulta tiene que sobrevivir a que la nota se borre, porque
  /// justamente sirve para revisar qué se preguntaba sobre ella.
  notaSlug String?

  /// La nota que el lector tenía abierta al preguntar, si tenía alguna.
  contextoSlug String?

  fecha DateTime @default(now())

  /// El tablero lista lo no respondido, y lo más reciente primero.
  @@index([resultado, fecha])
  @@map("consultas_migue")
}

/// Cuántas consultas al MODELO lleva alguien en la hora en curso.
///
/// Existe para que una edición del diario no se coma el presupuesto del
/// municipio: cada pregunta que llega al modelo cuesta plata, y no hay nada que
/// frene a alguien que insista.
///
/// **No guarda el id del usuario, guarda un hash salado con `SESSION_SECRET`.**
/// Con eso alcanza para contar por persona sin poder decir quién es: el
/// registro de preguntas (`ConsultaMigue`) es anónimo a propósito, y meter acá
/// el id volvería a hacer identificable todo por cruce de horarios. El salteado
/// importa porque los ids de Cidituc son un espacio chico: un hash pelado se
/// revierte probando.
///
/// Las filas son efímeras: se limpian las ventanas viejas.
model ConsumoMigue {
  /// Hash del id de usuario. Nunca el id.
  clave     String
  /// El comienzo de la hora, truncado. Dos consultas de la misma hora caen en
  /// la misma fila y el contador es un incremento atómico.
  ventana   DateTime
  consultas Int      @default(0)

  @@id([clave, ventana])
  @@index([ventana])
  @@map("consumo_migue")
}

/// Quién quiere recibir El Sanmiguelino en papel.
///
/// Va en su propia tabla y no colgada de nada: son **datos personales de un
/// vecino** —nombre, edad, correo y domicilio— guardados por el municipio, y
/// mezclarlos con el resto haría que cualquier consulta de más los arrastre.
/// Es lo contrario del registro de Migue, que a propósito no guarda quién
/// pregunta: acá el dato ES la persona, porque hay que llevarle el diario.
///
/// Cuando llegue el SSO de Cidituc, `nombre` y `edad` van a salir de ahí y el
/// formulario va a pedir sólo correo y domicilio. Por eso `usuarioId` se
/// guarda desde ahora: es lo que después permite reconocer al mismo vecino.
model Suscripcion {
  id        String @id @default(cuid())
  nombre    String
  /// Opcional: hoy la carga la persona, y no es un dato que valga la pena
  /// exigir para recibir un diario.
  edad      Int?
  /// Único: dos suscripciones al mismo correo son la misma persona apretando
  /// el botón dos veces, no dos ejemplares.
  email     String @unique
  direccion String

  /// De qué sesión salió: el `id_persona` de Cidituc desde el 2026-09-01.
  /// Las filas anteriores a esa fecha traen el id único que repartía el mock,
  /// así que no identifican a nadie.
  usuarioId String?

  fecha DateTime @default(now())

  @@index([fecha])
  @@map("suscripciones")
}

/// Quién entró al diario por Cidituc, y qué puede hacer acá.
///
/// Cidituc dice QUIÉN es cada uno; qué puede hacer lo decide esta tabla. La fila
/// la escribe el callback del ingreso, no la carga nadie a mano: hasta que
/// alguien entra una primera vez, para el diario esa persona no existe. Como
/// consecuencia, un administrador cargado en `CIDITUC_ADMINS` que nunca ingresó
/// **no aparece acá**, y la pantalla del panel tiene que decirlo o su número
/// miente.
///
/// **No hay historial de ingresos, y es deliberado.** Es una sola columna que se
/// pisa. Guardar cada entrada convertiría esto en un registro de la actividad de
/// un vecino ante el municipio, que es otra cosa y necesitaría otro permiso — el
/// mismo argumento por el que `ConsultaMigue` no guarda quién pregunta. Tampoco
/// se guardan el CUIL ni el DNI que Cidituc devuelve: una lista para cambiar
/// roles no necesita documentos.
///
/// **Sin relaciones hacia `Comentario`, `Voto` ni `Suscripcion`**, a propósito.
/// Hay `usuarioId` de la época del login mock que no corresponden a ningún
/// `id_persona`, así que la clave externa fallaría al crearse; y borrar a alguien
/// de acá no puede arrastrar los comentarios de un vecino.
model Usuario {
  /// El `id_persona` de Cidituc ES la clave primaria: acá no va `cuid()`.
  ///
  /// Es la única excepción del esquema y tiene motivo: los otros modelos generan
  /// su id porque nadie de afuera se lo provee, y éste ya viene validado por el
  /// backend municipal, ya viaja en la sesión y ya está desnormalizado en
  /// `Comentario.usuarioId`, `Voto.usuarioId` y `Suscripcion.usuarioId`. Con un
  /// cuid propio harían falta dos claves y un `@unique` sobre la que de verdad
  /// identifica.
  id String @id

  /// Nombre y apellido ya juntados, normalizados y recortados, tal como los arma
  /// el callback. Se pisa en cada ingreso: acá es un espejo de Cidituc.
  ///
  /// En `Comentario.usuarioNombre` es exactamente lo contrario, y también a
  /// propósito: ahí queda congelado, porque es el nombre con el que la persona
  /// firmó ese día.
  nombre String

  /// "lector" | "editor" | "admin". Es texto y no enum de Postgres por lo mismo
  /// que `Comentario.estado` y `ConsultaMigue.resultado`: sumar un rol no puede
  /// ser una migración con lock de tabla.
  ///
  /// Acá el texto suma un argumento que allá no estaba: si la base trae un rol
  /// que este código todavía no conoce, se cae a "lector" —lo menos— en vez de
  /// romper. Un enum de Prisma con un valor nuevo tira al deserializar, y eso
  /// sería una instancia vieja tumbando el ingreso al diario por un permiso.
  /// La contracara obligatoria vive en `src/lib/auth/roles.ts`: el texto crudo se
  /// valida contra los roles conocidos, nunca se afirma con `as`.
  rol String @default("lector")

  /// Columna aparte y NO un cuarto valor de `rol`, porque son dos preguntas
  /// distintas: qué puede hacer, y si puede entrar. Como valor de `rol` el
  /// bloqueo borraría el rol que la persona tenía, así que desbloquearla
  /// obligaría a adivinarlo de nuevo.
  bloqueado Boolean @default(false)

  /// La última vez que entró. Se pisa; no hay historial (ver arriba).
  ///
  /// No es `@updatedAt`: ningún modelo del esquema lo usa, y acá además mentiría.
  /// `@updatedAt` también se movería cuando un administrador le cambia el rol, o
  /// sea que la columna diría "entró" cuando en realidad "la tocaron".
  ultimoIngreso DateTime @default(now())

  /// Rastro del último cambio de rol o de bloqueo, igual que la baja de un
  /// comentario: una publicación oficial que le saca permisos a alguien tiene que
  /// poder decir quién lo decidió. No es el historial completo — eso es otra tabla
  /// y todavía no hace falta.
  cambiadoPor String?
  cambiadoEn  DateTime?

  /// El listado del panel: los que entraron hace menos, primero.
  @@index([ultimoIngreso])
  @@map("usuarios")
}
