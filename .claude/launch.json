{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "el-sanmiguelino",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "el-sanmiguelino-3005",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "el-sanmiguelino-con-cidituc-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000,
      "env": {
        "CIDITUC_LOGIN_URL": "http://localhost:5175",
        "CIDITUC_CALLBACK_URL": "http://localhost:3000/auth/cidituc/callback"
      }
    },
    {
      "name": "cidituc",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/repo/cidituc",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "env": {
        "VITE_APP_RUTA_BACK": "https://estadisticas.smt.gob.ar:5000",
        "VITE_APP_SANMIGUELINO_CALLBACK_URL": "http://localhost:3000/auth/cidituc/callback"
      }
    }
  ]
}
